---
/**
 * Capa de um post. Com imagem, renderiza <Image> otimizada.
 * Sem imagem, cai no corte diagonal da marca com o símbolo.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import simbolo from '../assets/simbolo.svg';

interface Props {
  cover?: ImageMetadata;
  alt?: string;
  /** larguras geradas para srcset */
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
  /** 'hero' posiciona o símbolo à direita, fora do título */
  variante?: 'card' | 'hero';
}

const {
  cover,
  alt = '',
  widths = [480, 768, 1200],
  sizes = '100vw',
  loading = 'lazy',
  class: className,
  variante = 'card',
} = Astro.props;
---

{
  cover ? (
    <Image
      src={cover}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading={loading}
      class:list={['capa', className]}
    />
  ) : (
    <div class:list={['capa', 'capa--vazia', `capa--${variante}`, 'corte-diagonal', className]} aria-hidden="true">
      <img src={simbolo.src} alt="" class="capa__simbolo" loading={loading} />
    </div>
  )
}

<style>
  .capa {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .capa--vazia {
    display: grid;
    place-items: center;
  }

  .capa__simbolo {
    position: relative;
    width: 28%;
    max-width: 220px;
    filter: drop-shadow(0 12px 32px rgba(0, 0, 0, 0.35));
  }
</style>

<style>
  .capa--hero {
    place-items: center end;
    padding-right: clamp(var(--space-8), 10vw, 160px);
  }

  .capa--hero .capa__simbolo {
    width: clamp(160px, 22vw, 320px);
    max-width: none;
    opacity: 0.9;
  }

  @media (max-width: 767px) {
    .capa--hero {
      place-items: start end;
      padding-top: var(--space-8);
    }
  }
</style>
